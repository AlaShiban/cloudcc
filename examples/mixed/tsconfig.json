{
  "compilerOptions": {
    "target": "ES2022",
    // Bundler resolution: this unit is bundled by esbuild on the way out and
    // run by tsx before that.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api.ts"]
}
