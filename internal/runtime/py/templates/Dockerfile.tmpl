#
# Supply your own Dockerfile in the source tree to take over completely: cloudcc
# copies it through untouched rather than generating this one.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8080
{{if .ASGIApp}}
CMD ["sh", "-c", "exec uvicorn {{.EntryModule}}:{{.ASGIApp}} --host 0.0.0.0 --port ${PORT}"]
{{else}}
CMD ["python", "-m", "{{.EntryModule}}"]
{{end}}
