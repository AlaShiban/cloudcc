#!/usr/bin/env bash
# Generated by cloudcc. Builds a deployment artefact for each execution unit.
#
# Pulumi does not install Python dependencies for you, so this runs before
# `pulumi up`. `cloudcc deploy` invokes it automatically.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"

PY_VERSION="{{.PythonVersion}}"
build="build"

if ! command -v uv >/dev/null 2>&1; then
  echo "package.sh: uv is required to install dependencies (brew install uv)" >&2
  exit 1
fi

rm -rf "$build"
mkdir -p "$build"

{{range .Units}}{{if .Container}}
echo "packaging execution unit {{.ID}} (container)"
if command -v docker >/dev/null 2>&1; then
  docker build --quiet --tag "cloudcc-{{.ID}}:latest" "{{.ID}}" >/dev/null
  echo "  built image cloudcc-{{.ID}}:latest"
  echo "  push it after \`pulumi up\` with bin/push-images.sh"
else
  echo "  docker is not installed; skipping the image build for {{.ID}}" >&2
  echo "  install it with: brew install --cask docker" >&2
fi
{{else}}
echo "packaging execution unit {{.ID}}"
unit_build="$build/{{.ID}}"
mkdir -p "$unit_build"
cp -R "{{.ID}}/." "$unit_build/"

if [ -s "{{.ID}}/requirements.txt" ]; then
  uv pip install \
    --quiet \
    --target "$unit_build" \
    --python-version "$PY_VERSION" \
    --only-binary=:all: \
    -r "{{.ID}}/requirements.txt"
fi

# Deterministic zip: fixed timestamps and sorted entries, so an unchanged unit
# produces a byte-identical artefact and Pulumi sees no diff.
find "$unit_build" -name '__pycache__' -type d -prune -exec rm -rf {} +
find "$unit_build" -exec touch -t 198001010000 {} +
( cd "$unit_build" && find . -type f | LC_ALL=C sort | zip -q -X -@ "../{{.ID}}.zip" )
echo "  wrote $build/{{.ID}}.zip"
{{end}}{{end}}

echo "packaging complete"
