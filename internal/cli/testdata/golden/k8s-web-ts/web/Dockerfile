# The image carries one file. bin/package.sh bundles this unit the same way it
# bundles a function -- esbuild, to a single index.mjs -- so there is no source
# tree to copy, no npm install to run, and no question of whether `node` can
# load the entry: by this point it is plain JavaScript whatever the unit was
# written in. The .mjs extension is what says ESM, so not even a package.json
# is needed.
FROM node:22-slim

ENV NODE_ENV=production \
    PORT=8080

WORKDIR /app

COPY index.mjs ./

EXPOSE 8080
CMD ["node", "index.mjs"]
