// Architecture of k8s-web, generated by cloudcc.
digraph "k8s-web" {
    rankdir=LR;
    node [shape=box, style=rounded, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    execution_unit_web [label="web\\nexecution_unit", shape=box];
    expose_web_front [label="web-front\\nexpose", shape=ellipse];
    expose_web_front -> execution_unit_web [label="exposes"];
}
