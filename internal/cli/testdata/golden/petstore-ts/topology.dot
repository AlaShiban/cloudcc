// Architecture of petstore-ts, generated by cloudcc.
digraph "petstore-ts" {
    rankdir=LR;
    node [shape=box, style=rounded, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    execution_unit_summary [label="summary\\nexecution_unit", shape=box];
    execution_unit_web [label="web\\nexecution_unit", shape=box];
    expose_pet_api [label="pet-api\\nexpose", shape=ellipse];
    persist_kv_petsByOwner [label="petsByOwner\\npersist_kv", shape=cylinder];
    execution_unit_web -> execution_unit_summary [label="calls", penwidth=2];
    expose_pet_api -> execution_unit_web [label="exposes"];
    execution_unit_web -> execution_unit_summary [label="uses"];
    execution_unit_web -> persist_kv_petsByOwner [label="uses"];
}
