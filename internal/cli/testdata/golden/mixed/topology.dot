// Architecture of mixed, generated by cloudcc.
digraph "mixed" {
    rankdir=LR;
    node [shape=box, style=rounded, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    execution_unit_api [label="api\\nexecution_unit", shape=box];
    execution_unit_worker [label="worker\\nexecution_unit", shape=box];
    expose_pet_api [label="pet-api\\nexpose", shape=ellipse];
    persist_kv_petsByOwner [label="petsByOwner\\npersist_kv", shape=cylinder];
    expose_pet_api -> execution_unit_api [label="exposes"];
    execution_unit_api -> persist_kv_petsByOwner [label="uses"];
    execution_unit_worker -> persist_kv_petsByOwner [label="uses"];
}
