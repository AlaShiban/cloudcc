// Architecture of petstore-node, generated by cloudcc.
digraph "petstore-node" {
    rankdir=LR;
    node [shape=box, style=rounded, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    execution_unit_main [label="main\\nexecution_unit", shape=box];
    execution_unit_summary [label="summary\\nexecution_unit", shape=box];
    expose_pet_api [label="pet-api\\nexpose", shape=ellipse];
    persist_kv_petsByOwner [label="petsByOwner\\npersist_kv", shape=cylinder];
    execution_unit_main -> execution_unit_summary [label="calls", penwidth=2];
    expose_pet_api -> execution_unit_main [label="exposes"];
    execution_unit_main -> execution_unit_summary [label="uses"];
    execution_unit_main -> persist_kv_petsByOwner [label="uses"];
}
